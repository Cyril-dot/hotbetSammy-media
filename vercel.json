{
  "buildCommand": "pnpm exec vite build",
  "installCommand": "pnpm install",
  "outputDirectory": "dist/public",
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "https://futballbackend-production-ee88.up.railway.app/api/$1"
    },
    {
      "src": "^/admin(?:/.*)?$",
      "dest": "/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}
